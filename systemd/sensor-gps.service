[Unit]
Description=Arduino UNO Q water-quality and GPS ROS 2 stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@RUN_USER@
Group=@RUN_GROUP@
SupplementaryGroups=docker
Environment=HOME=@HOME_DIR@
Environment=SENSOR_GPS_PROJECT_DIR=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/start_water_quality.sh
ExecStop=-/usr/bin/docker stop ros_jazzy_container
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
